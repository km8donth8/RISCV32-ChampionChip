# Team 41 (Equipe 41) - ChampionCHIP Stage 3
# make            : build both firmwares, run both testbenches, render figures
# make firmware   : assemble official + TollGuard firmware (organisers' builder)
# make sim        : run tb_official_fw and tb_app_fw (Icarus Verilog)
# make figures    : waveform PNGs from the VCDs (python3 + matplotlib)
# make flat       : single-file SoC Verilog per firmware (rtl/flat/)
# make model      : regenerate tb/app_vectors.vh and emu/emu_tests.sh

RTL = rtl/core/core_modules_equipe41.v rtl/soc/lsu_dmem_equipe41.v \
      rtl/periph/GPIO_equipe41.v rtl/periph/UART_equipe41.v \
      rtl/soc/MemoryUnit_SoC_equipe41.v rtl/soc/soc_top_equipe41.v

.PHONY: all firmware model sim sim-official sim-app figures flat synth-check clean

all: firmware model sim figures flat

firmware:
	firmware/build.sh official
	firmware/build.sh app

model:
	python3 scripts/tollguard_model.py

sim: sim-official sim-app

sim-official:
	sim/run.sh official

sim-app:
	sim/run.sh app

figures:
	python3 scripts/make_figures.py

flat:
	mkdir -p rtl/flat
	for fw in official app; do \
	  { echo "// soc_top_equipe41 + IMEM ($$fw firmware) - single-file build, generated by 'make flat'"; \
	    cat $(RTL) rtl/imem/IMEM_$$fw.v; } > rtl/flat/soc_top_equipe41_$$fw.v; done

synth-check:
	for fw in official app; do \
	  yosys -q -p "read_verilog $(RTL) rtl/imem/IMEM_$$fw.v; hierarchy -check -top soc_top_equipe41; proc; opt; check -assert"; done

clean:
	rm -rf firmware/*/build results/*.vcd results/*.vvp
